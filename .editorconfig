# Shared across the four zcohen-nerd repos. Last synced 2026-08-31.
# charset = utf-8 here means UTF-8 *without* a BOM — hold that line.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown uses trailing spaces for hard line breaks.
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
