{
  "arrowParens": "always",
  "bracketSpacing": false,
  "printWidth": 80,
  "singleQuote": true,
  "trailingComma": "all",
  "overrides": [
    {
      "files": ["*.md", "*.mdx"],
      "options": {"proseWrap": "preserve"}
    },
    {
      "files": ["*.yml", "*.yaml"],
      "options": {"singleQuote": false}
    }
  ]
}
